# ==============================================================================
# Formant — Environment Variables Baseline
# ==============================================================================
# Copy this file to .env (or .env.local) and provide actual values.
# Real credentials must NEVER be committed to version control.
#
# DUAL-STATE NOTE:
# If Supabase variables are omitted or empty, Formant automatically runs in
# offline "Demo Mode" backed by an in-browser localStorage store (careerlyst_demo).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Frontend)
# ------------------------------------------------------------------------------
# [Required for Cloud Mode] Project URL for your remote Supabase instance.
# Referenced in: src/lib/supabase.js
# Example: https://bofsshercyihwnsbblzp.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# [Required for Cloud Mode] Client public anonymous / publishable key.
# Referenced in: src/lib/supabase.js
# Note: The client checks VITE_SUPABASE_PUBLISHABLE_KEY first, with a fallback
# to VITE_SUPABASE_ANON_KEY. Safe to expose in client-side bundles.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# [Optional] Canonical Site Origin URL for SEO, canonical tags, and OpenGraph.
# If omitted or empty, defaults to the active deployment origin.
# Example: https://formant.com
# VITE_SITE_URL=https://formant.com

# Optional alias for the anonymous key (fallback if VITE_SUPABASE_PUBLISHABLE_KEY is unset):
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Browser Web Push Notifications (Optional Frontend)
# ------------------------------------------------------------------------------
# [Optional] VAPID Public Key for client browser Web Push subscription registration.
# Referenced in: src/lib/pushNotifications.js
# If omitted or empty, push notification subscription is gracefully skipped.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ------------------------------------------------------------------------------
# 3. Supabase Edge Functions Secrets (Backend Reference Only)
# ------------------------------------------------------------------------------
# These variables are required ONLY by backend Edge Functions (send-push-notification).
# DO NOT place them in frontend client-side .env files or expose them to the browser.
# Set them in your remote Supabase project via:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=...
#
# SUPABASE_URL=injected-automatically-by-supabase-edge-runtime
# SUPABASE_SERVICE_ROLE_KEY=injected-automatically-by-supabase-edge-runtime
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key-NEVER-EXPOSE-TO-CLIENT
# VAPID_SUBJECT=mailto:admin@formant.com
