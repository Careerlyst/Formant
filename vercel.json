{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/signup",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/auth/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/forgot-password",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/reset-password",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/assessment",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/service-selection",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/dashboard",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ],
  "redirects": [
    { "source": "/services/cover-letter", "destination": "/services/cover", "permanent": true },
    { "source": "/services/interview-preparation", "destination": "/services/interview", "permanent": true },
    { "source": "/services/resume-cv", "destination": "/services/resume", "permanent": true },
    { "source": "/services/cv", "destination": "/services/resume", "permanent": true },
    { "source": "/services/linkedin-profile", "destination": "/services/linkedin", "permanent": true },
    { "source": "/services/github-profile", "destination": "/services/github", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": true }
  ],
  "rewrites": [
    { "source": "/services", "destination": "/seo/services.html" },
    { "source": "/showcase", "destination": "/seo/showcase.html" },
    { "source": "/pricing", "destination": "/seo/pricing.html" },
    { "source": "/about", "destination": "/seo/about.html" },
    { "source": "/contact", "destination": "/seo/contact.html" },
    { "source": "/services/resume", "destination": "/seo/services-resume.html" },
    { "source": "/services/linkedin", "destination": "/seo/services-linkedin.html" },
    { "source": "/services/github", "destination": "/seo/services-github.html" },
    { "source": "/services/portfolio", "destination": "/seo/services-portfolio.html" },
    { "source": "/services/cover", "destination": "/seo/services-cover.html" },
    { "source": "/services/interview", "destination": "/seo/services-interview.html" },
    { "source": "/privacy", "destination": "/seo/privacy.html" },
    { "source": "/terms", "destination": "/seo/terms.html" },
    { "source": "/refund", "destination": "/seo/refund.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
